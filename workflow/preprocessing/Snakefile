from utils.ModuleConfig import ModuleConfig
from pathlib import Path

mcfg = ModuleConfig(
    module_name="preprocessing",
    global_config=config
)

# add integration controls to integration methods list when benchmarking
int_controls_nolabel = [
    "batchwise-pca",
    "shuffle-per-batch",
]
int_controls_label = [
    "perfect-embed-label",
    "perfect-embed-label-jitter",
    "shuffle-per-label",
]

if mcfg.config["integration"]["benchmark"]:
    methods = mcfg.config["integration"]["methods"]
    methods.update({m: {} for m in int_controls_nolabel}) # add no-label controls
    if mcfg.config["integration"]["label_key"] is not None: # add label-based controls
        methods.update({m: {} for m in int_controls_label})

